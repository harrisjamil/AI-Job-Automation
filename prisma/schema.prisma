generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  fullName     String
  email        String @unique
  username     String @unique
  passwordHash String

  country         String?
  city            String?
  timezone        String?
  experienceYears Int?
  primaryRole     String?
  preferredJobType String?
  workPreference  String?
  englishLevel    String?

  githubUrl             String?
  linkedinUrl           String?
  portfolioUrl          String?
  expectedSalary        Int?
  salaryPeriod          String?
  noticePeriod          String?
  availableHoursPerWeek Int?
  preferredTechStack    String[] @default([])
  preferredCompanySize  String?
  preferredIndustries   String[] @default([])
  willingOverlapUsEu    Boolean  @default(false)
  degree                String?
  university            String?
  graduationYear        Int?
  certifications        String[] @default([])
  careerGoal            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills         UserSkill[]
  projects       Project[]
  resumes        Resume[]
  jobPreferences JobPreferences?
  aiPlatforms    AiPlatform[]
  crawlRuns      CrawlRun[]
  jobs           Job[]
  outreachEmails OutreachEmail[]
  emailAccount   EmailAccount?

  @@index([email])
  @@index([username])
}

model AiPlatform {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  name             String
  apiKey           String
  modelId          String
  baseUrl          String?
  isActive         Boolean   @default(true)
  lastTestedAt     DateTime?
  lastTestStatus   String?
  lastTestMessage  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, provider])
}

model Skill {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  userSkills UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  years   String
  level   String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  techStack   String[] @default([])
  githubUrl   String?
  liveUrl     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id         String  @id @default(cuid())
  userId     String
  fileName   String
  fileUrl    String
  mimeType   String?
  parsedJson Json?
  atsScore   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model JobPreferences {
  userId               String   @id
  targetRoles          String[] @default([])
  targetCountries      String[] @default([])
  includeKeywords      String[] @default([])
  excludeKeywords      String[] @default([])
  remoteOnly           Boolean  @default(true)
  scheduledCrawlEnabled Boolean  @default(false)
  crawlIntervalHours   Int      @default(6)
  lastScheduledAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Normalized employer directory used by ATS + careers crawlers.
model Company {
  id         String   @id @default(cuid())
  name       String
  domain     String?
  websiteUrl String?
  careersUrl String?
  atsType    String?
  atsSlug    String?
  category   String   @default("tech")
  isRemoteFriendly Boolean @default(true)
  isActive   Boolean  @default(true)
  jobs       Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([atsType, atsSlug])
  @@index([atsType])
  @@index([isActive])
  @@index([name])
}

/// Registry of crawl sources (remote boards, ATS, careers, etc.).
model JobSource {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  category    String
  priority    Int     @default(50)
  isEnabled   Boolean @default(true)
  crawlMethod String  @default("api")
  baseUrl     String?
  config      Json?
  lastCrawlAt DateTime?
  lastStatus  String?
  lastError   String?
  jobsFound   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isEnabled, priority])
}

model CrawlRun {
  id         String    @id @default(cuid())
  userId     String
  status     String    @default("running")
  sources    String[]  @default([])
  jobsFound  Int       @default(0)
  keywords   String[]  @default([])
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  crawlRunId     String?
  companyId      String?
  externalId     String
  source         String
  sourceCategory String    @default("remote_board")
  title          String
  company        String?
  location       String?
  isRemote       Boolean   @default(false)
  url            String
  description    String?
  salary         String?
  tags           String[]  @default([])
  fingerprint    String?
  skillsMatched  String[]  @default([])
  matchScore     Int       @default(0)
  postedAt       DateTime?
  scrapedAt      DateTime  @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  crawlRun       CrawlRun?       @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  companyRef     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contacts       JobContact[]
  outreachEmails OutreachEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([userId, matchScore])
  @@index([crawlRunId])
  @@index([userId, isRemote])
  @@index([userId, fingerprint])
  @@index([companyId])
  @@index([sourceCategory])
}

model JobContact {
  id         String  @id @default(cuid())
  jobId      String
  name       String?
  email      String
  role       String?
  sourceUrl  String?
  confidence Float   @default(0.5)

  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outreachEmails OutreachEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, email])
  @@index([jobId])
  @@index([email])
}

model OutreachEmail {
  id                String    @id @default(cuid())
  userId            String
  jobId             String
  contactId         String?
  toEmail           String
  subject           String
  body              String
  status            String    @default("draft")
  providerMessageId String?
  sentAt            DateTime?
  error             String?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact JobContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([jobId])
}

model EmailAccount {
  id        String  @id @default(cuid())
  userId    String  @unique
  provider  String
  fromEmail String
  fromName  String?
  apiKey    String?
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?
  smtpSecure Boolean @default(true)
  isActive  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
