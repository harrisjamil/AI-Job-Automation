generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  fullName     String
  email        String @unique
  username     String @unique
  passwordHash String

  country         String?
  city            String?
  timezone        String?
  experienceYears Int?
  primaryRole     String?
  preferredJobType String?
  workPreference  String?
  englishLevel    String?

  githubUrl             String?
  linkedinUrl           String?
  portfolioUrl          String?
  expectedSalary        Int?
  salaryPeriod          String?
  noticePeriod          String?
  availableHoursPerWeek Int?
  preferredTechStack    String[] @default([])
  preferredCompanySize  String?
  preferredIndustries   String[] @default([])
  willingOverlapUsEu    Boolean  @default(false)
  degree                String?
  university            String?
  graduationYear        Int?
  certifications        String[] @default([])
  careerGoal            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills              UserSkill[]
  projects            Project[]
  resumes             Resume[]
  jobPreferences      JobPreferences?
  aiPlatforms         AiPlatform[]
  crawlRuns           CrawlRun[]
  jobs                Job[]
  outreachEmails      OutreachEmail[]
  applications        JobApplication[]
  emailAccount        EmailAccount?
  jobDocuments        JobDocument[]
  assistantThreads    AssistantThread[]
  extensionTokens     ExtensionToken[]
  notifications       AppNotification[]

  @@index([email])
  @@index([username])
}

model AiPlatform {
  id               String    @id @default(cuid())
  userId           String
  provider         String
  name             String
  apiKey           String
  modelId          String
  baseUrl          String?
  isActive         Boolean   @default(true)
  lastTestedAt     DateTime?
  lastTestStatus   String?
  lastTestMessage  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, provider])
}

model Skill {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  userSkills UserSkill[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  years   String
  level   String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  techStack   String[] @default([])
  githubUrl   String?
  liveUrl     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id         String  @id @default(cuid())
  userId     String
  fileName   String
  fileUrl    String
  mimeType   String?
  parsedJson Json?
  atsScore   Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model JobPreferences {
  userId               String   @id
  targetRoles          String[] @default([])
  targetCountries      String[] @default([])
  includeKeywords      String[] @default([])
  excludeKeywords      String[] @default([])
  remoteOnly           Boolean  @default(true)
  scheduledCrawlEnabled Boolean  @default(false)
  crawlIntervalHours   Int      @default(6)
  lastScheduledAt      DateTime?
  /// Email digest when high-score jobs appear after a crawl
  alertsEnabled        Boolean  @default(true)
  alertMinScore        Int      @default(55)
  lastAlertedAt        DateTime?
  /// Daily email when application follow-up dates are due
  followUpRemindersEnabled Boolean @default(true)
  /// Prepare apply packages for high-score jobs (cover letter + resume + tracker)
  autoApplyEnabled   Boolean @default(false)
  autoApplyMinScore  Int     @default(70)
  /// After preparing, set application status to applied and suggest opening the URL
  autoApplyMarkApplied Boolean @default(true)
  /// Days until follow-up after auto-apply (0 = skip)
  autoApplyFollowUpDays Int @default(7)

  /// Slack incoming webhook for high-score / crawl / interview alerts
  slackWebhookUrl String?
  /// Store notifications in-app (header bell)
  inAppAlertsEnabled Boolean @default(true)
  /// Email/Slack when an interview date is approaching
  interviewRemindersEnabled Boolean @default(true)

  /// Last scheduled/manual crawl failure message (for Settings health)
  lastCrawlError    String?
  lastCrawlFailedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Normalized employer directory used by ATS + careers crawlers.
model Company {
  id         String   @id @default(cuid())
  name       String
  domain     String?
  websiteUrl String?
  careersUrl String?
  atsType    String?
  atsSlug    String?
  category   String   @default("tech")
  isRemoteFriendly Boolean @default(true)
  isActive   Boolean  @default(true)
  jobs       Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([atsType, atsSlug])
  @@index([atsType])
  @@index([isActive])
  @@index([name])
}

/// Registry of crawl sources (remote boards, ATS, careers, etc.).
model JobSource {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  category    String
  priority    Int     @default(50)
  isEnabled   Boolean @default(true)
  crawlMethod String  @default("api")
  baseUrl     String?
  config      Json?
  lastCrawlAt DateTime?
  lastStatus  String?
  lastError   String?
  jobsFound   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isEnabled, priority])
}

model CrawlRun {
  id         String    @id @default(cuid())
  userId     String
  status     String    @default("running")
  sources    String[]  @default([])
  jobsFound  Int       @default(0)
  keywords   String[]  @default([])
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  crawlRunId     String?
  companyId      String?
  externalId     String
  source         String
  sourceCategory String    @default("remote_board")
  title          String
  company        String?
  location       String?
  isRemote       Boolean   @default(false)
  url            String
  description    String?
  salary         String?
  tags           String[]  @default([])
  fingerprint    String?
  skillsMatched  String[]  @default([])
  matchScore     Int       @default(0)
  postedAt       DateTime?
  scrapedAt      DateTime  @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  crawlRun       CrawlRun?       @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  companyRef     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contacts       JobContact[]
  outreachEmails OutreachEmail[]
  application    JobApplication?
  documents      JobDocument[]
  alertedAt      DateTime?
  gapAnalysisJson    Json?
  gapAnalyzedAt      DateTime?
  interviewPrepJson  Json?
  interviewPrepAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([userId, matchScore])
  @@index([crawlRunId])
  @@index([userId, isRemote])
  @@index([userId, fingerprint])
  @@index([companyId])
  @@index([sourceCategory])
  @@index([userId, alertedAt])
}

/// Tracks formal application pipeline for a discovered job.
model JobApplication {
  id           String    @id @default(cuid())
  userId       String
  jobId        String    @unique
  /// saved | outreach | applied | interview | offer | rejected | withdrawn
  status       String    @default("saved")
  notes        String?
  followUpAt   DateTime?
  /// Set after a follow-up reminder email is sent for the current followUpAt
  followUpRemindedAt DateTime?
  appliedAt    DateTime?
  statusChangedAt DateTime @default(now())
  /// idle | preparing | ready | submitted | failed
  autoApplyStatus String?
  autoApplyError  String?
  /// Snapshot of materials used for apply (cover letter, resume, profile answers)
  applyPackageJson Json?
  autoPreparedAt   DateTime?
  /// none | awaiting | replied | bounced | ghosted
  replyStatus      String    @default("none")
  lastReplyAt      DateTime?
  /// Number of automated outreach follow-ups sent for this application
  outreachFollowUpCount Int @default(0)
  lastOutreachFollowUpAt DateTime?

  /// Scheduled interview datetime (local intent; stored as UTC)
  interviewAt DateTime?
  /// Set after an interview reminder notification/email is sent
  interviewRemindedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, followUpAt])
  @@index([userId, replyStatus])
  @@index([userId, interviewAt])
}

model JobContact {
  id         String  @id @default(cuid())
  jobId      String
  name       String?
  email      String
  role       String?
  sourceUrl  String?
  confidence Float   @default(0.5)

  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  outreachEmails OutreachEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, email])
  @@index([jobId])
  @@index([email])
}

model OutreachEmail {
  id                String    @id @default(cuid())
  userId            String
  jobId             String
  contactId         String?
  toEmail           String
  subject           String
  body              String
  status            String    @default("draft")
  providerMessageId String?
  sentAt            DateTime?
  error             String?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contact JobContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([jobId])
}

model EmailAccount {
  id        String  @id @default(cuid())
  userId    String  @unique
  provider  String
  fromEmail String
  fromName  String?
  apiKey    String?
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?
  smtpSecure Boolean @default(true)
  isActive  Boolean @default(true)

  /// IMAP inbox for automatic reply detection (optional)
  imapHost   String?
  imapPort   Int?
  imapUser   String?
  imapPass   String?
  imapSecure Boolean @default(true)
  replySyncEnabled Boolean @default(false)
  lastReplySyncAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// In-app notification feed (header bell).
model AppNotification {
  id     String  @id @default(cuid())
  userId String
  /// high_score_jobs | crawl_failed | interview_reminder | reply_detected | follow_up | system
  type   String
  title  String
  body   String?
  href   String?
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Per-job cover letter or tailored resume draft.
model JobDocument {
  id             String   @id @default(cuid())
  userId         String
  jobId          String
  /// cover_letter | tailored_resume
  type           String
  title          String?
  content        String
  structuredJson Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId, type])
  @@index([userId, jobId])
  @@index([jobId])
}

model AssistantThread {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
}

model AssistantMessage {
  id        String   @id @default(cuid())
  threadId  String
  /// user | assistant
  role      String
  content   String
  createdAt DateTime @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([threadId, createdAt])
}

/// API tokens for the Chrome form-fill extension.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// Prefix shown in UI (e.g. aja_xxxx…)
  tokenPrefix String
  label      String    @default("Chrome extension")
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
